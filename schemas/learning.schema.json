{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ctf-skills/learning.schema.json",
  "title": "Append-only CTF learning record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "title", "category", "subcategories", "trigger_conditions", "challenge_context",
    "observed_problem", "technique", "core_insight", "commands_or_code",
    "verification_evidence", "resulting_primitive", "flag_verified", "failure_modes",
    "when_not_to_use", "related_existing_techniques", "source_type",
    "source_reference", "confidence", "date_added"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 3},
    "category": {"enum": ["ctf-ai-ml", "ctf-crypto", "ctf-forensics", "ctf-malware", "ctf-misc", "ctf-osint", "ctf-pwn", "ctf-reverse", "ctf-web"]},
    "subcategories": {"type": "array", "items": {"type": "string"}},
    "trigger_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "challenge_context": {"type": "string"},
    "observed_problem": {"type": "string"},
    "technique": {"type": "string"},
    "core_insight": {"type": "string"},
    "commands_or_code": {"type": ["string", "array"]},
    "verification_evidence": {"type": "string"},
    "resulting_primitive": {"type": "string"},
    "flag_verified": {"type": "boolean"},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "when_not_to_use": {"type": "array", "items": {"type": "string"}},
    "related_existing_techniques": {"type": "array", "items": {"type": "string"}},
    "source_type": {"type": "string"},
    "source_reference": {"type": "string"},
    "confidence": {"enum": ["low", "medium", "high", "verified"]},
    "date_added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "materially_contributed": {"type": "boolean"},
    "reusable": {"type": "boolean"},
    "reproducible": {"type": "boolean"},
    "category_confidence": {"enum": ["low", "medium", "high", "verified"]},
    "aliases": {"type": "array", "items": {"type": "string"}}
  }
}
